# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456:replace-me
# Comma-separated chats: id or name=id. Name can be used as chat_id when sending. First is default
ALLOWED_CHAT_IDS=me=111111111,friend=222222222
# Optional: extra directories whose files are sent without asking (the session directory is always allowed)
# ALLOWED_DIRS=/path/to/dir
# ask = confirm files outside allowed roots, strict = refuse them
# ACCESS_MODE=ask
# Optional: extra paths that are never sent
# DENY_PATHS=/path/to/secret
